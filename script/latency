#!/usr/bin/env bash

set -euo pipefail

probe="${1:-syscall_getpid}"
shift || true

stamp="$(date -u +%Y%m%dT%H%M%SZ)"
out_dir="${NAPKIN_LATENCY_OUT_DIR:-target/napkin-latency}"
mkdir -p "${out_dir}"

csv="${NAPKIN_LATENCY_CSV:-${out_dir}/${stamp}-${probe}.csv}"
csv_arg=(--csv "${csv}")
for arg in "$@"; do
  if [[ "${arg}" == "--csv" || "${arg}" == --csv=* ]]; then
    csv_arg=()
    break
  fi
done

latency_args=(--probe "${probe}")
if (( ${#csv_arg[@]} > 0 )); then
  latency_args+=("${csv_arg[@]}")
fi
latency_args+=("$@")

RUSTFLAGS="-C target-cpu=native" \
  cargo run --release --bin latency -- \
    "${latency_args[@]}"
